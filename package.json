{
  "name": "sentiment-analyzer",
  "version": "1.0.0",
  "private": true,
  "description": "Upload a call transcript, orchestrate analysis through n8n + Claude, and read the result as a KPI dashboard.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-n8n-workflow.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "build:workflow": "node scripts/build-n8n-workflow.mjs",
    "verify:workflow": "node scripts/verify-workflow.mjs",
    "test": "node --import tsx --test src/lib/*.test.ts",
    "check": "npm run typecheck && npm run verify:workflow && npm run test",
    "n8n:simulate": "node scripts/simulate-n8n.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3"
  }
}
