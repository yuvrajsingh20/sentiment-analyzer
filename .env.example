# ─────────────────────────────────────────────────────────────────────────────
# Authentication (login screen)
# ─────────────────────────────────────────────────────────────────────────────
# Credentials for the demo login screen.
AUTH_USERNAME=analyst
AUTH_PASSWORD=change-me

# Secret used to sign the session cookie (HMAC-SHA256).
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# Session lifetime in seconds (default 43200 = 12h)
SESSION_TTL_SECONDS=43200

# Optional Google sign-in. Client ID alone is enough for Continue with Google.
# In Google Cloud Console → Credentials, on the OAuth client add:
#   Authorized JavaScript origin:  http://localhost:3000
#   Authorized redirect URI:       http://localhost:3000/api/auth/callback/google
# GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google


# ─────────────────────────────────────────────────────────────────────────────
# AI provider — Gemini (UI → Gemini → quality gate)
# ─────────────────────────────────────────────────────────────────────────────
# Required for analysis. Get a key from https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_MS=120000


# ─────────────────────────────────────────────────────────────────────────────
# MongoDB Atlas (analysis history)
# ─────────────────────────────────────────────────────────────────────────────
# When set, previous analyses are stored in Atlas instead of data/history/.
# Add your current IP (or 0.0.0.0/0 for deploy) under Network Access.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net
# MONGODB_DB=sentiment-analyzer
