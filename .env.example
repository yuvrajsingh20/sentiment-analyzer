# ─────────────────────────────────────────────────────────────────────────────
# Authentication (login screen)
# ─────────────────────────────────────────────────────────────────────────────
# Credentials for the demo login screen.
AUTH_USERNAME=analyst
AUTH_PASSWORD=change-me

# Secret used to sign the session cookie (HMAC-SHA256).
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# Session lifetime in seconds (default 43200 = 12h)
SESSION_TTL_SECONDS=43200


# ─────────────────────────────────────────────────────────────────────────────
# Orchestration: n8n  (UI → n8n → AI)
# ─────────────────────────────────────────────────────────────────────────────
# Production webhook URL of the imported n8n workflow.
# When set, ALL analysis is routed through n8n.
# When unset, the app falls back to calling Claude directly with the identical
# prompt + JSON schema, so the app is demoable without an n8n instance.
# N8N_WEBHOOK_URL=https://your-n8n-host/webhook/sentiment-analyze

# Shared secret sent as the `x-api-key` header to the n8n webhook.
# Must match the value configured in the workflow's "Verify shared secret" node.
# N8N_WEBHOOK_SECRET=replace-with-a-long-random-string

# Milliseconds to wait for n8n before failing (default 120000)
# N8N_TIMEOUT_MS=120000


# ─────────────────────────────────────────────────────────────────────────────
# AI provider
# ─────────────────────────────────────────────────────────────────────────────
# Required for the direct fallback path (and used by n8n's HTTP Request node
# via its own credential when running through the workflow).
ANTHROPIC_API_KEY=sk-ant-...

# Optional override. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5
